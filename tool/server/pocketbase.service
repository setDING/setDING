# PocketBase backend of RealChord (ADR-0004). Installed by tool/server/install.sh.
# Listens on localhost only; the Cloudflare tunnel publishes it (ADR-0014).
[Unit]
Description=PocketBase (RealChord backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
# Optional settings for the hooks, e.g. the deep-link verification files
# (docs/operations/server.md, "Deep links").
EnvironmentFile=-/etc/realchord/pocketbase.env
ExecStart=/opt/pocketbase/pocketbase serve \
  --http=127.0.0.1:8090 \
  --dir=/var/lib/pocketbase/pb_data \
  --hooksDir=/opt/pocketbase/pb_hooks \
  --hooksWatch=false \
  --migrationsDir=/opt/pocketbase/pb_migrations
Restart=always
RestartSec=5
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
