# Example systemd unit for the server bundle (ADR-0063 §2a). Until the
# self-hosting documentation shows it (#1053), this file is the example the
# bundle smoke test (server/test/bundle_test.dart) starts and
# tool/check-ops.sh verifies. It is not part of the release.
#
# Layout: the unpacked bundle in /opt/setding/setding-server-<version>, the
# symlink /opt/setding/current pointing to it, the data in
# /var/lib/setding/pb_data, the settings in /etc/setding/setding.env.
[Unit]
Description=setDING server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=setding
Group=setding
EnvironmentFile=/etc/setding/setding.env
ExecStart=/opt/setding/current/pocketbase serve \
  --http=127.0.0.1:8090 \
  --dir=/var/lib/setding/pb_data \
  --hooksDir=/opt/setding/current/pb_hooks \
  --hooksWatch=false \
  --migrationsDir=/opt/setding/current/pb_migrations \
  --publicDir=/opt/setding/current/pb_public
Restart=always
RestartSec=5
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/setding
ProtectHome=true

[Install]
WantedBy=multi-user.target
